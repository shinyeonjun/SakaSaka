# 실행 프로세스에 환경변수로 전달하십시오. .env 자동 로딩은 제공하지 않습니다.
API_HOST=127.0.0.1
API_PORT=8787
INTENT_WORLD_STATE_FILE=.data/state.json
INTENT_WORLD_RAW_DIR=.data/raw
# Autonomous Intent Runtime v2 durable coverage/gap state. Main AppState remains backward compatible.
INTENT_WORLD_AUTONOMY_FILE=.data/autonomy.json
# `npm run decision:setup`이 쓰는 로컬 decision 설정/secret 파일. 비우면 state.json 옆 decision-settings.json을 사용합니다.
INTENT_WORLD_DECISION_SETTINGS_FILE=
# WORKSPACE_ROOT는 실제 존재하는 전용 테스트 폴더를 지정하십시오.
WORKSPACE_ROOT=
VITE_API_URL=http://localhost:8787

# 모델: auto는 명시적으로 설정된 HTTP API, 그다음 Codex CLI를 선택합니다.
CODEX_CLI_ENABLED=true
# Windows에서는 실제 실행 가능한 codex.exe 경로를 확인하십시오.
CODEX_CLI_BIN=codex
CODEX_CLI_MODEL=
# 실제 설치/계정에서 확인한 ID만 설정합니다. 빈 값은 추천 목록을 만들지 않습니다.
# 비워두면 제품 기본 추천 목록을 표시합니다. 실제 계정 지원 여부는 첫 모델 호출에서 확인합니다.
CODEX_CLI_MODELS=
CODEX_CLI_TIMEOUT_MS=120000
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_STRUCTURED_OUTPUT=json-schema
# 청구 가격 보장이 아닌 추정 단가. 0은 무료라는 뜻이 아닙니다.
MODEL_COST_PER_MILLION=0
DEFAULT_RUN_BUDGET=30

# Autonomous Intent Runtime v2
# 기본적으로 codex-cli 및 auto→Codex 프로젝트에서 활성화됩니다.
SAKASAKA_AUTONOMY_DISABLED=false
# true이면 deterministic/openai-compatible 프로젝트에도 coverage supervisor를 적용합니다.
SAKASAKA_AUTONOMY_ALL_PROVIDERS=false
# 서로 독립된 fresh-context discovery scout 수. 실제 repo write worker는 아직 1개만 허용합니다.
SAKASAKA_DISCOVERY_PARALLELISM=3
# 작업이 끝나지 않았더라도 이 주기로 coverage를 다시 탐색합니다.
SAKASAKA_COVERAGE_REVIEW_MINUTES=60

# Bounded semantic decision layer. 운영 환경변수가 있으면 로컬 `decision:setup` 값보다 우선합니다.
# 아무 환경변수도 없으면 로컬 decision-settings.json, 그 다음 codex-cli 기본값을 사용합니다.
SAKASAKA_DECISION_PROVIDER=
CODEX_DECISION_TIMEOUT_MS=90000
# TypeSafe 공식 SDK와 동일한 환경변수 이름을 지원합니다.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=
TYPESAFE_TIMEOUT_MS=20000
# 이전 실험 설정과의 호환용. 새 설정에서는 TYPESAFE_DEFAULT_MODEL을 권장합니다.
TYPESAFE_JEV_MODEL=
# 완전한 endpoint를 강제로 지정할 때만 사용합니다. 일반적으로 TYPESAFE_BASE_URL을 사용하십시오.
TYPESAFE_API_URL=
# TypeSafe 공개 가격을 반영한 로컬 추정값. 실제 청구의 source of truth는 provider입니다.
JEV_COST_PER_MILLION=0.042

# Docker 자체도 완전한 보안 경계 검증이 끝난 것은 아닙니다. 문서 참조.
SANDBOX_IMAGE=node:22-alpine
# DB를 쓰지 않는 제품이면 비워둡니다. 기본 샘플 자격 증명을 넣지 않습니다.
DATABASE_URL=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 외부 바인딩에는 token이 필수이며 현재 UI는 로컬 API 사용이 기본입니다.
SAKASAKA_API_TOKEN=
SAKASAKA_ALLOWED_ORIGINS=
SAKASAKA_ALLOWED_HOSTS=

# Optional dedicated native Codex home (log in there separately; never commit auth files)
SAKASAKA_CODEX_HOME=
# Only for CI/local integration; public pinned CLI, no real model auth required
# SAKASAKA_TEST_CODEX_BIN=/path/to/codex
