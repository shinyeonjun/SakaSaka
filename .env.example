# 실행 프로세스에 환경변수로 전달하십시오. .env 자동 로딩은 제공하지 않습니다.
API_HOST=127.0.0.1
API_PORT=8787
INTENT_WORLD_STATE_FILE=.data/state.json
INTENT_WORLD_RAW_DIR=.data/raw
# WORKSPACE_ROOT는 실제 존재하는 전용 테스트 폴더를 지정하십시오.
WORKSPACE_ROOT=
VITE_API_URL=http://localhost:8787

# 모델: auto는 명시적으로 설정된 HTTP API, 그다음 Codex CLI를 선택합니다.
CODEX_CLI_ENABLED=true
# Windows에서는 실제 실행 가능한 codex.exe 경로를 확인하십시오.
CODEX_CLI_BIN=codex
CODEX_CLI_MODEL=
# 실제 설치/계정에서 확인한 ID만 설정합니다. 빈 값은 추천 목록을 만들지 않습니다.
# 비워두면 제품 기본 추천 목록을 표시합니다. 실제 계정 지원 여부는 첫 모델 호출에서 확인합니다.
CODEX_CLI_MODELS=
CODEX_CLI_TIMEOUT_MS=120000
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_STRUCTURED_OUTPUT=json-schema
# 청구 가격 보장이 아닌 추정 단가. 0은 무료라는 뜻이 아닙니다.
MODEL_COST_PER_MILLION=0
DEFAULT_RUN_BUDGET=30

# Docker 자체도 완전한 보안 경계 검증이 끝난 것은 아닙니다. 문서 참조.
SANDBOX_IMAGE=node:22-alpine
# DB를 쓰지 않는 제품이면 비워둡니다. 기본 샘플 자격 증명을 넣지 않습니다.
DATABASE_URL=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 외부 바인딩에는 token이 필수이며 현재 UI는 로컬 API 사용이 기본입니다.
SAKASAKA_API_TOKEN=
SAKASAKA_ALLOWED_ORIGINS=
SAKASAKA_ALLOWED_HOSTS=
