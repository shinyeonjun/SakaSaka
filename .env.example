API_PORT=8787
INTENT_WORLD_STATE_FILE=.data/state.json
DATABASE_URL=postgres://intent:intent@postgres:5432/intent_world
REDIS_URL=redis://redis:6379
OBJECT_STORE_ENDPOINT=http://object-store:9000
OBJECT_STORE_BUCKET=intent-world
MODEL_PROVIDER_KEYS=
# 모델 연결: auto는 OpenAI 호환 API를 우선하고, 아래 플래그가 켜져 있으면 Codex CLI를 사용합니다.
CODEX_CLI_ENABLED=false
CODEX_CLI_BIN=codex
CODEX_CLI_MODEL=
# 비워두면 Codex provider 기본 catalog를 사용하고, 지정하면 실제 모델 ID 목록으로 덮어씁니다.
CODEX_CLI_MODELS=
CODEX_CLI_TIMEOUT_MS=120000
SANDBOX_IMAGE=intent-world-sandbox:local
SANDBOX_EGRESS_POLICY=allowlist
DEFAULT_RUN_BUDGET=30
OTEL_EXPORTER_OTLP_ENDPOINT=
VITE_API_URL=http://localhost:8787
